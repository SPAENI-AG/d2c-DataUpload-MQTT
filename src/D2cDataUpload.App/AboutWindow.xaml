<Window x:Class="D2cDataUpload.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:D2cDataUpload.App"
        Title="{l:Tr Menu_AboutTitle}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/icon.ico">
    <Border Margin="12" Padding="20,18" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/icon.ico" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock x:Name="tb_Title" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="tb_Version" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{l:Tr About_Text}" TextWrapping="Wrap" Margin="0,14,0,10" Foreground="{StaticResource TextBrush}"/>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,3,14,3"/>
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Text="{l:Tr About_Company}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tb_Company" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{l:Tr About_Developer}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tb_Developer"/>
                <TextBlock Grid.Row="2" Text="{l:Tr About_Support}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1">
                    <Hyperlink x:Name="hl_Support" RequestNavigate="Link_RequestNavigate">
                        <Run x:Name="run_Support"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="3" Text="{l:Tr About_Email}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Row="3" Grid.Column="1">
                    <Hyperlink x:Name="hl_Email" RequestNavigate="Link_RequestNavigate">
                        <Run x:Name="run_Email"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <TextBlock x:Name="tb_Copyright" Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>

            <Button Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="bt_Ok_Click"/>
        </StackPanel>
    </Border>
</Window>
