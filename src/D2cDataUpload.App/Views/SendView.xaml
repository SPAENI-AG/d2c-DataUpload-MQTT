<UserControl x:Class="D2cDataUpload.App.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:D2cDataUpload.App">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="420"/> <!-- Arbeitsbereich -->
            <RowDefinition Height="8"/>                 <!-- Splitter -->
            <RowDefinition Height="120" MinHeight="50"/> <!-- Log -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Datei -->
            <RowDefinition Height="Auto"/>   <!-- Info -->
            <RowDefinition Height="*" MinHeight="110"/> <!-- Vorschau -->
            <RowDefinition Height="Auto"/>   <!-- Zuordnung -->
            <RowDefinition Height="Auto"/>   <!-- Beispiel -->
            <RowDefinition Height="Auto"/>   <!-- Senden -->
        </Grid.RowDefinitions>

        <!-- Datei -->
        <DockPanel Grid.Row="0">
            <Button x:Name="bt_Reload" DockPanel.Dock="Right" Content="{l:Tr Btn_Reload}" Margin="4,2,0,2" Click="bt_Reload_Click"/>
            <Button x:Name="bt_Open" DockPanel.Dock="Right" Content="{l:Tr Btn_OpenCsv}" Margin="6,2,0,2" Click="bt_Open_Click"/>
            <TextBox x:Name="tb_Path" IsReadOnly="True" Background="White"/>
        </DockPanel>
        <TextBlock x:Name="tb_Info" Grid.Row="1" Margin="2,2,0,6" Style="{StaticResource MutedText}"/>

        <!-- Vorschau -->
        <DataGrid x:Name="dg_Preview" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="All"
                  EnableRowVirtualization="True" RowHeaderWidth="34" LoadingRow="dg_Preview_LoadingRow"/>

        <!-- Zuordnung -->
        <GroupBox x:Name="gb_Mapping" Grid.Row="3">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Tr Grp_Mapping}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Style="{StaticResource HelpButton}" Tag="zuordnung" Click="Help_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="3" Text="{l:Tr Mapping_Question}" Margin="0,0,0,6" Style="{StaticResource MutedText}"/>

                <!-- Topic -->
                <TextBlock Grid.Row="1" Text="{l:Tr Lbl_Topic}" Foreground="{StaticResource TopicBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                <RadioButton x:Name="rb_TopicColumn" Grid.Row="1" Grid.Column="1" GroupName="topic" Content="{l:Tr Rb_FromColumn}"
                             VerticalAlignment="Center" Margin="0,0,12,0" Checked="Mapping_Changed"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                    <ComboBox x:Name="cb_TopicColumn" Width="200" SelectionChanged="Mapping_Changed"/>
                    <TextBlock Text="{l:Tr Lbl_Prefix}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="tb_TopicPrefix" Width="160" TextChanged="Mapping_Changed" ToolTip="{l:Tr Tip_Prefix}"/>
                </StackPanel>
                <RadioButton x:Name="rb_TopicTemplate" Grid.Row="2" Grid.Column="1" GroupName="topic" Content="{l:Tr Rb_Template}"
                             VerticalAlignment="Center" Checked="Mapping_Changed"/>
                <TextBox x:Name="tb_TopicTemplate" Grid.Row="2" Grid.Column="2" TextChanged="Mapping_Changed"
                         ToolTip="{l:Tr Tip_Template}"/>

                <!-- Payload -->
                <TextBlock Grid.Row="3" Text="{l:Tr Lbl_Payload}" Foreground="{StaticResource PayloadBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <RadioButton x:Name="rb_PayloadColumn" Grid.Row="3" Grid.Column="1" GroupName="payload" Content="{l:Tr Rb_FromColumn}"
                             VerticalAlignment="Center" Margin="0,6,12,0" Checked="Mapping_Changed"/>
                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="cb_PayloadColumn" Width="200" SelectionChanged="Mapping_Changed"/>
                    <TextBlock Text="{l:Tr Lbl_SendAsIs}" VerticalAlignment="Center" Margin="12,0,12,0" Style="{StaticResource MutedText}"/>
                    <CheckBox x:Name="chk_ValidateJson" Content="{l:Tr Chk_ValidateJson}" Checked="Mapping_Changed" Unchecked="Mapping_Changed"/>
                </StackPanel>
                <RadioButton x:Name="rb_PayloadJson" Grid.Row="4" Grid.Column="1" GroupName="payload" Content="{l:Tr Rb_JsonFromColumns}"
                             VerticalAlignment="Top" Margin="0,6,12,0" Checked="Mapping_Changed"/>
                <DockPanel x:Name="dp_Json" Grid.Row="4" Grid.Column="2" Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="170">
                        <TextBlock Text="{l:Tr Lbl_TsColumn}"/>
                        <ComboBox x:Name="cb_TsColumn" SelectionChanged="Mapping_Changed"/>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" MaxHeight="64" ToolTip="{l:Tr Tip_JsonColumns}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ic_JsonColumns" Margin="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- Beispielnachricht -->
        <TextBox x:Name="tb_Sample" Grid.Row="4" Style="{StaticResource MonoBox}" Height="62"
                 TextWrapping="NoWrap" Margin="0,2,0,4"/>

        <!-- Senden: Bereich, Aktionen, Fortschritt, Statistik -->
        <GroupBox Grid.Row="5">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Tr Grp_Run}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource HelpButton}" Tag="senden" Click="Help_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="tb_RateInfo" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Tr Lbl_FromRow}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="tb_StartRow" Width="90" Text="1"/>
                        <Button x:Name="bt_Resume" Margin="6,2,0,2" IsEnabled="False" Click="bt_Resume_Click"/>
                        <TextBlock Text="{l:Tr Lbl_Count}" VerticalAlignment="Center" Margin="20,0,6,0"/>
                        <TextBox x:Name="tb_Count" Width="90" Text="0"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="bt_Start" Style="{StaticResource PrimaryButton}" Click="bt_Start_Click">
                        <TextBlock><Run Text="▶  "/><Run Text="{l:Tr Btn_Start}"/></TextBlock>
                    </Button>
                    <Button x:Name="bt_Pause" Margin="8,0,0,0" Click="bt_Pause_Click"/>
                    <Button x:Name="bt_Stop" Margin="8,0,0,0" Click="bt_Stop_Click">
                        <TextBlock><Run Text="■  "/><Run Text="{l:Tr Btn_Stop}"/></TextBlock>
                    </Button>
                    <Button x:Name="bt_DryRun" Margin="24,0,0,0" Content="{l:Tr Btn_DryRun}" ToolTip="{l:Tr Tip_DryRun}" Click="bt_DryRun_Click"/>
                </StackPanel>

                <Grid Height="20">
                    <ProgressBar x:Name="pb_Progress" Minimum="0" Maximum="1000"/>
                    <TextBlock x:Name="tb_Percent" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_State}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" x:Name="tb_State" Text="–"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Connection}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource StatValue}" x:Name="tb_Conn" Text="–"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Position}"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource StatValue}" x:Name="tb_Pos" Text="–"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Sent}"/>
                    <TextBlock Grid.Column="7" Style="{StaticResource StatValue}" x:Name="tb_Sent" Text="–"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Acked}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="tb_Acked" Text="–"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Skipped}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource StatValue}" x:Name="tb_Errors" Text="–"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Rate}"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource StatValue}" x:Name="tb_Rate" Text="–"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Style="{StaticResource StatLabel}" Text="{l:Tr Stat_Eta}"/>
                    <TextBlock Grid.Row="1" Grid.Column="7" Style="{StaticResource StatValue}" x:Name="tb_Eta" Text="–"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        </Grid>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Log -->
        <TextBox x:Name="tb_Log" Grid.Row="2" Style="{StaticResource MonoBox}" TextWrapping="NoWrap"
                 AcceptsReturn="True" Margin="0"/>
    </Grid>
</UserControl>
