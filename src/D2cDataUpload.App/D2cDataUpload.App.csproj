<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D2cDataUpload.App</RootNamespace>
    <AssemblyName>d2c_DataUpload_MQTT</AssemblyName>

    <!-- Version, Firma, Repository: siehe Directory.Build.props -->

    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- erlaubt Build/CI auch ausserhalb von Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- Web-Hilfe: wird neben die exe kopiert (auch beim Veröffentlichen als Einzeldatei) -->
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D2cDataUpload.Core\D2cDataUpload.Core.csproj" />
  </ItemGroup>

</Project>
